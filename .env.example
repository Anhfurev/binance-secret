# Sentry (Next.js) — create a project at https://sentry.io/, then Client Keys (DSN)
# Use the same DSN for both unless you split browser vs server projects.
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=

# Optional: upload source maps on `next build` (Auth Tokens in Sentry settings)
# SENTRY_AUTH_TOKEN=
# SENTRY_ORG=your-org-slug
# SENTRY_PROJECT=your-project-slug
#
# Production VPS: do NOT set NODE_OPTIONS=--inspect (or leave it unset).
# Sentry includeLocalVariables also opens node:inspector — keep it off in sentry.server.config.ts.

# --- Binance live (spot) ---
# Create API key at https://www.binance.com/en/my/settings/api-management
# Permissions: Enable Reading + Enable Spot & Margin Trading (no Withdraw unless you need it).
# IP restriction: allow your Oracle gateway IP (BINANCE_REST_GATEWAY_URL host) — direct calls from
# laptop/Vercel will fail with -2015 if only the gateway IP is whitelisted.
# BINANCE_API_KEY=
# BINANCE_API_SECRET=
# BINANCE_REST_GATEWAY_URL=http://<your-gateway-ip>
# BINANCE_GATEWAY_SECRET=
# Edge + cron must use the same keys (supabase secrets set --env-file .env.local …)

# Paper 15m route → public.trades (required for device:* demo workspaces; use your auth.users uuid)
# PAPER_TRADES_USER_ID=
# PAPER_SCALP_WALLET_USD=28
# PAPER_TELEGRAM_PULSE_EVERY_MS=1800000

# Paper manifest Telegram (binance-app /api/automation/paper/run)
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
# CRON_SECRET=
