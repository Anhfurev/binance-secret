# Sentry (Next.js) — create a project at https://sentry.io/, then Client Keys (DSN)
# Use the same DSN for both unless you split browser vs server projects.
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=

# Optional: upload source maps on `next build` (Auth Tokens in Sentry settings)
# SENTRY_AUTH_TOKEN=
# SENTRY_ORG=your-org-slug
# SENTRY_PROJECT=your-project-slug
#
# Production VPS: do NOT set NODE_OPTIONS=--inspect (or leave it unset).
# Sentry includeLocalVariables also opens node:inspector — keep it off in sentry.server.config.ts.

# --- Binance live (spot) ---
# Create API key at https://www.binance.com/en/my/settings/api-management
# Permissions: Enable Reading + Enable Spot & Margin Trading (no Withdraw unless you need it).
# IP restriction: Binance API key must allowlist the gateway VPS public IP only.
# All signed REST must go through nginx (not https://api.binance.com directly).
# Vultr Sydney example:
# BINANCE_REST_GATEWAY_URL=http://45.76.115.143
# BINANCE_GATEWAY_SECRET=<same secret as nginx setup on that VM>
# BINANCE_API_KEY=
# BINANCE_API_SECRET=
# Optional stream ticks via gateway: BINANCE_STREAM_TICK_GATEWAY_URL=http://45.76.115.143
# Spot-only on Vultr (disable futures fast lane — fapi is not proxied by the gateway):
# FAST_BOUNCE_FUTURES_LANE=0
# Edge + cron must use the same keys (supabase secrets set --env-file .env.local …)

# Paper 15m route → public.trades (required for device:* demo workspaces; use your auth.users uuid)
# PAPER_TRADES_USER_ID=
# PAPER_SCALP_WALLET_USD=28
# PAPER_TELEGRAM_PULSE_EVERY_MS=1800000

# Vultr / Edge bot — cron summary Telegram (all symbols per digest)
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
# TELEGRAM_CRON_DIGEST=1
# TELEGRAM_CRON_DIGEST_MS=120000
# TELEGRAM_CRON_DIGEST_WALLET=1
# Optional: one huge trace per symbol each cron (noisy with 10 bots):
# CRON_SUPER_DETAILED_TRACE_TELEGRAM=1
# TELEGRAM_NOTIFY_ERRORS=true

# Paper manifest Telegram (binance-app /api/automation/paper/run)
# CRON_SECRET=
